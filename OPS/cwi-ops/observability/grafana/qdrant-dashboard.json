{
  "uid": "cwi-qdrant-overview",
  "title": "Qdrant Vector Shard Overview",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "tags": [
    "cwi",
    "qdrant",
    "vector-shard"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Shard Up",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "up{job=\"cwi-vector-shard\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP Request Rate",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(rate({__name__=~\"qdrant_.*http.*requests.*\"}[5m]))",
          "legendFormat": "http",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "gRPC Request Rate",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(rate({__name__=~\"qdrant_.*grpc.*requests.*\"}[5m]))",
          "legendFormat": "grpc",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Collection Points",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum({__name__=~\"qdrant_.*collection.*points.*\"})",
          "legendFormat": "points",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Segment Count",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum({__name__=~\"qdrant_.*segment.*\"})",
          "legendFormat": "segments",
          "refId": "A"
        }
      ]
    }
  ]
}
