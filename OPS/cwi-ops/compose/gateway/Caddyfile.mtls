# Caddyfile template with upstream TLS/mTLS
{
	admin off
	auto_https disable_redirects
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers>Authorization delete
				request>headers>Cookie delete
				request>headers>Set-Cookie delete
			}
		}
	}
}

{$CWI_DOMAIN} {
	handle_errors {
		@packs_error path /packs/* /swagger* /swagger/*
		respond @packs_error "pack_service_unavailable" 503
		@identity_error path /auth/* /jwks*
		respond @identity_error "identity_service_unavailable" 503
		@api_error path /api/*
		respond @api_error "router_unavailable" 503
	}

	tls {$CADDY_EMAIL}
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "accelerometer=(), camera=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
		X-Frame-Options "DENY"
		Strict-Transport-Security "{$HSTS_HEADER}"
		X-Request-Id "{http.request.id}"
		X-CWI-Origin "gateway"
		-Server
		-X-Powered-By
	}
	@csp_strict not path /swagger /swagger/*
	header @csp_strict {
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'"
	}

	@mtls_disabled expression {env.UPSTREAM_MTLS_ENABLED} == "false"
	@allow_insecure expression {env.ALLOW_INSECURE_UPSTREAM} == "true"

	@healthz path /healthz
	respond @healthz 200

	@swagger path /swagger /swagger/*
	header @swagger {
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' http: https:; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'"
	}

	@readyz path /readyz
	handle @readyz {
		rewrite * /api/ready
		handle @mtls_disabled {
			handle @allow_insecure {
				reverse_proxy {$ROUTER_HOSTPORT} {
					header_up X-Request-Id "{http.request.id}"
					header_up X-Request-Start "{time.now.unix_ms}"
				}
			}
			respond 503
		}
		reverse_proxy {$ROUTER_HOSTPORT} {
			transport http {
				tls
				tls_trust_pool file {$ROUTER_TLS_CA}
				tls_client_auth {$ROUTER_TLS_CERT} {$ROUTER_TLS_KEY}
			}
			header_up X-Request-Id "{http.request.id}"
			header_up X-Request-Start "{time.now.unix_ms}"
		}
	}

	@packs path /packs /packs/*
	handle @packs {
		handle @mtls_disabled {
			handle @allow_insecure {
				reverse_proxy {$PACK_SERVICE_HOSTPORT} {
					header_up X-Request-Id "{http.request.id}"
					header_up X-Request-Start "{time.now.unix_ms}"
				}
			}
			respond 503
		}
		reverse_proxy {$PACK_SERVICE_HOSTPORT} {
			transport http {
				tls
				tls_trust_pool file {$PACK_TLS_CA}
				tls_client_auth {$PACK_TLS_CERT} {$PACK_TLS_KEY}
			}
			header_up X-Request-Id "{http.request.id}"
			header_up X-Request-Start "{time.now.unix_ms}"
		}
	}

	@swagger path /swagger /swagger/*
	handle @swagger {
		handle @mtls_disabled {
			handle @allow_insecure {
				reverse_proxy {$PACK_SERVICE_HOSTPORT} {
					header_up X-Request-Id "{http.request.id}"
					header_up X-Request-Start "{time.now.unix_ms}"
				}
			}
			respond 503
		}
		reverse_proxy {$PACK_SERVICE_HOSTPORT} {
			transport http {
				tls
				tls_trust_pool file {$PACK_TLS_CA}
				tls_client_auth {$PACK_TLS_CERT} {$PACK_TLS_KEY}
			}
			header_up X-Request-Id "{http.request.id}"
			header_up X-Request-Start "{time.now.unix_ms}"
		}
	}

	handle_path /artifacts/* {
		handle @mtls_disabled {
			handle @allow_insecure {
				reverse_proxy {$PACK_SERVICE_HOSTPORT} {
					header_up X-Request-Id "{http.request.id}"
					header_up X-Request-Start "{time.now.unix_ms}"
				}
			}
			respond 503
		}
		reverse_proxy {$PACK_SERVICE_HOSTPORT} {
			transport http {
				tls
				tls_trust_pool file {$PACK_TLS_CA}
				tls_client_auth {$PACK_TLS_CERT} {$PACK_TLS_KEY}
			}
			header_up X-Request-Id "{http.request.id}"
			header_up X-Request-Start "{time.now.unix_ms}"
		}
	}

	@identity path /auth/* /jwks*
	handle @identity {
		handle @mtls_disabled {
			handle @allow_insecure {
				reverse_proxy {$IDENTITY_HOSTPORT} {
					header_up X-Request-Id "{http.request.id}"
					header_up X-Request-Start "{time.now.unix_ms}"
				}
			}
			respond 503
		}
		reverse_proxy {$IDENTITY_HOSTPORT} {
			transport http {
				tls
				tls_trust_pool file {$IDENTITY_TLS_CA}
				tls_client_auth {$IDENTITY_TLS_CERT} {$IDENTITY_TLS_KEY}
			}
			header_up X-Request-Id "{http.request.id}"
			header_up X-Request-Start "{time.now.unix_ms}"
		}
	}

	@ui_api path /api/login /api/health /api/packs /api/packs/*
	reverse_proxy @ui_api {$GPT_WEB_UI_HOSTPORT} {
		header_up X-Request-Id "{http.request.id}"
		header_up X-Request-Start "{time.now.unix_ms}"
	}

	handle_path /coordination/* {
		handle @mtls_disabled {
			handle @allow_insecure {
				reverse_proxy {$COORDINATION_HOSTPORT} {
					header_up X-Request-Id "{http.request.id}"
					header_up X-Request-Start "{time.now.unix_ms}"
				}
			}
			respond 503
		}
		reverse_proxy {$COORDINATION_HOSTPORT} {
			transport http {
				tls
				tls_trust_pool file {$COORDINATION_TLS_CA}
				tls_client_auth {$COORDINATION_TLS_CERT} {$COORDINATION_TLS_KEY}
			}
			header_up X-Request-Id "{http.request.id}"
			header_up X-Request-Start "{time.now.unix_ms}"
		}
	}

	@api path /api/*
	handle @api {
		handle @mtls_disabled {
			handle @allow_insecure {
				reverse_proxy {$ROUTER_HOSTPORT} {
					header_up X-Request-Id "{http.request.id}"
					header_up X-Request-Start "{time.now.unix_ms}"
				}
			}
			respond 503
		}
		reverse_proxy {$ROUTER_HOSTPORT} {
			transport http {
				tls
				tls_trust_pool file {$ROUTER_TLS_CA}
				tls_client_auth {$ROUTER_TLS_CERT} {$ROUTER_TLS_KEY}
			}
			header_up X-Request-Id "{http.request.id}"
			header_up X-Request-Start "{time.now.unix_ms}"
			health_uri /api/ready
		}
	}

	@mcp path /mcp/*
	@mcp_enabled expression {env.MCP_ALIAS_ENABLED} == "true"
	handle @mcp {
		handle @mcp_enabled {
			handle @mtls_disabled {
				handle @allow_insecure {
					reverse_proxy {$ROUTER_HOSTPORT} {
						header_up X-Request-Id "{http.request.id}"
						header_up X-Request-Start "{time.now.unix_ms}"
					}
				}
				respond 503
			}
			reverse_proxy {$ROUTER_HOSTPORT} {
				transport http {
					tls
					tls_trust_pool file {$ROUTER_TLS_CA}
					tls_client_auth {$ROUTER_TLS_CERT} {$ROUTER_TLS_KEY}
				}
				header_up X-Request-Id "{http.request.id}"
				header_up X-Request-Start "{time.now.unix_ms}"
			}
		}
		respond 404
	}
}
