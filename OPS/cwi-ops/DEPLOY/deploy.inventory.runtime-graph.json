{
  "defaults": {
    "sshUser": "root",
    "deployRoot": "/opt/cwi/DEPLOY",
    "bundleRoot": "OPS/cwi-ops/DEPLOY",
    "composeCommand": "docker compose",
    "composeFile": "docker-compose.yml",
    "composeArgs": "up -d",
    "deploymentMode": "safe",
    "seedEnvFromTemplate": true,
    "clearContainersBeforeDeploy": false,
    "clearImagesBeforeDeploy": false,
    "clearVolumesBeforeDeploy": false
  },
  "hosts": [
    {
      "name": "internal-mcp-01",
      "host": "100.120.208.51",
      "roles": [
        {
          "name": "mcp-core",
          "composeArgs": "up -d --force-recreate cwi-identity-server cwi-orchestrator cwi-router",
          "buildContextPaths": [
            "global.json",
            "src/backend/common",
            "src/backend/services/cwi-identity-server",
            "src/backend/services/cwi-orchestrator",
            "contracts/grpc",
            "contracts/json-schema"
          ],
          "buildImages": [
            {
              "image": "local/cwi-identity-server:gpt-login-fix-20260429T0247Z",
              "dockerfile": "src/backend/services/cwi-identity-server/Dockerfile"
            },
            {
              "image": "local/cwi-orchestrator:runtime-enforcement-20260428T2238Z",
              "dockerfile": "src/backend/services/cwi-orchestrator/Dockerfile"
            }
          ]
        },
        {
          "name": "cwi-admin-console",
          "composeArgs": "up -d --force-recreate cwi-admin-console",
          "buildContextPaths": [
            "contracts",
            "src/frontend/web-ui/cwi-admin-console"
          ],
          "buildImages": [
            {
              "image": "local/cwi-admin-console:latest",
              "dockerfile": "src/frontend/web-ui/cwi-admin-console/Dockerfile",
              "buildArgs": {
                "NEXT_PUBLIC_API_BASE_URL": "https://cwigpt.com",
                "NEXT_PUBLIC_BASE_PATH": "/administration",
                "NEXT_PUBLIC_IDENTITY_BASE_URL": "https://cwigpt.com",
                "NEXT_PUBLIC_OIDC_AUTHORITY": "",
                "NEXT_PUBLIC_OIDC_CLIENT_ID": "",
                "NEXT_PUBLIC_OIDC_REDIRECT_URI": "",
                "NEXT_PUBLIC_OIDC_POST_LOGOUT_REDIRECT_URI": "",
                "NEXT_PUBLIC_OIDC_SCOPES": "",
                "NEXT_PUBLIC_PACKS_BASE_URL": "https://cwigpt.com/packs"
              }
            }
          ]
        },
        {
          "name": "cwi-identity-admin",
          "deployPath": "/opt/cwi/DEPLOY/identity-admin",
          "composeArgs": "up -d --force-recreate cwi-identity-admin",
          "buildContextPaths": [
            "src/frontend/web-ui/cwi-identity-admin"
          ],
          "buildImages": [
            {
              "image": "local/cwi-identity-admin:tenant-modal-admin-20260428T2328Z",
              "dockerfile": "src/frontend/web-ui/cwi-identity-admin/Dockerfile",
              "context": "src/frontend/web-ui/cwi-identity-admin",
              "buildArgs": {
                "VITE_IDENTITY_BASE_URL": "http://100.120.208.51:8085",
                "VITE_ORCHESTRATOR_BASE_URL": "http://100.120.208.51:18085"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "public-gateway-01",
      "host": "100.124.140.66",
      "roles": [
        {
          "name": "cwi-gpt-web-ui",
          "composeArgs": "up -d --force-recreate cwi-gpt-web-ui",
          "buildContextPaths": [
            "contracts",
            "src/frontend/web-ui/cwi-gpt-web-ui"
          ],
          "buildImages": [
            {
              "image": "local/cwi-gpt-web-ui:connector-signin-20260428T2212Z",
              "dockerfile": "src/frontend/web-ui/cwi-gpt-web-ui/Dockerfile",
              "buildArgs": {
                "NEXT_PUBLIC_CWI_GATEWAY_BASE_URL": "https://cwigpt.com",
                "NEXT_PUBLIC_CWI_DEFAULT_TENANT": "CWI-ops",
                "NEXT_PUBLIC_CWI_AUTH_MODE": "token",
                "NEXT_PUBLIC_CWI_OIDC_AUTHORITY": "",
                "NEXT_PUBLIC_CWI_OIDC_CLIENT_ID": "",
                "NEXT_PUBLIC_CWI_OIDC_REDIRECT_URI": "",
                "NEXT_PUBLIC_CWI_OIDC_POST_LOGOUT_REDIRECT_URI": "",
                "NEXT_PUBLIC_CWI_OIDC_SCOPES": "",
                "NEXT_PUBLIC_CWI_POLICY_MODE": "observe",
                "NEXT_PUBLIC_CWI_ERROR_REPORT_URL": "",
                "NEXT_PUBLIC_CWI_REQUEST_TIMEOUT_MS": "120000",
                "NEXT_PUBLIC_CWI_BUILD_VERSION": "connector-signin-20260428T2212Z",
                "NEXT_PUBLIC_CWI_BUILD_SHA": "connector-signin-local"
              }
            }
          ]
        },
        {
          "name": "cwi-admin-console",
          "composeArgs": "up -d --force-recreate cwi-admin-console",
          "buildContextPaths": [
            "contracts",
            "src/frontend/web-ui/cwi-admin-console"
          ],
          "buildImages": [
            {
              "image": "local/cwi-admin-console:superadmin-console-tenantflow-20260423-161040",
              "dockerfile": "src/frontend/web-ui/cwi-admin-console/Dockerfile",
              "buildArgs": {
                "NEXT_PUBLIC_API_BASE_URL": "https://cwigpt.com",
                "NEXT_PUBLIC_BASE_PATH": "/administration",
                "NEXT_PUBLIC_IDENTITY_BASE_URL": "https://cwigpt.com",
                "NEXT_PUBLIC_OIDC_AUTHORITY": "",
                "NEXT_PUBLIC_OIDC_CLIENT_ID": "",
                "NEXT_PUBLIC_OIDC_REDIRECT_URI": "",
                "NEXT_PUBLIC_OIDC_POST_LOGOUT_REDIRECT_URI": "",
                "NEXT_PUBLIC_OIDC_SCOPES": "",
                "NEXT_PUBLIC_PACKS_BASE_URL": "https://cwigpt.com/packs"
              }
            }
          ]
        }
      ]
    }
  ]
}
