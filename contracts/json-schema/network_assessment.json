{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NetworkAssessment",
  "type": "object",
  "required": [
    "node_id",
    "interfaces"
  ],
  "properties": {
    "node_id": { "type": "string" },
    "observed_utc": { "type": "string", "format": "date-time" },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "interface"
        ],
        "properties": {
          "interface": { "type": "string" },
          "state": { "type": "string" },
          "signal_quality": { "type": "number", "minimum": 0, "maximum": 1 },
          "latency_ms": { "type": "number" },
          "jitter_ms": { "type": "number" },
          "packet_loss": { "type": "number", "minimum": 0, "maximum": 1 },
          "throughput_mbps": { "type": "number" },
          "bandwidth_mbps": { "type": "number" },
          "rssi_dbm": { "type": "number" },
          "snr_db": { "type": "number" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
