{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DegradationEvent",
  "type": "object",
  "required": ["event_id", "node_id", "observed_utc", "severity", "details"],
  "properties": {
    "event_id": { "type": "string" },
    "node_id": { "type": "string" },
    "observed_utc": { "type": "string", "format": "date-time" },
    "severity": { "type": "number", "minimum": 0, "maximum": 1 },
    "details": {
      "type": "object",
      "properties": {
        "observed_utc": { "type": "string", "format": "date-time" },
        "load_1": { "type": ["number", "null"] },
        "cpu_percent": { "type": ["number", "null"] },
        "disk_free_ratio": { "type": ["number", "null"] },
        "memory_free_ratio": { "type": ["number", "null"] },
        "cpu_severity": { "type": "number" },
        "disk_severity": { "type": "number" },
        "memory_severity": { "type": "number" }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": ["object", "null"],
      "properties": {
        "metrics_path": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
