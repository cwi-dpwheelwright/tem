{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TeacherCoherenceReport",
  "type": "object",
  "required": ["schema_version", "generated_utc", "status", "conflict_count"],
  "properties": {
    "schema_version": { "type": "string" },
    "generated_utc": { "type": "string" },
    "status": { "type": "string", "enum": ["pass", "warn", "fail"] },
    "conflict_count": { "type": "integer" },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "severity": { "type": "string" },
          "message": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
