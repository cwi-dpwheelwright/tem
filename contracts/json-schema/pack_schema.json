{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KnowledgePack",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "pack_id",
    "pack_version",
    "name",
    "modules"
  ],
  "properties": {
    "pack_id": {
      "type": "string",
      "minLength": 1
    },
    "pack_version": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "dependencies": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PackDependency"
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "packs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/PackDependency"
              }
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/PackDependency"
              }
            }
          }
        }
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "PackDependency": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "pack_id"
      ],
      "properties": {
        "pack_id": {
          "type": "string",
          "minLength": 1
        },
        "pack_version": {
          "type": "string",
          "minLength": 1
        },
        "optional": {
          "type": "boolean"
        }
      }
    }
  }
}
