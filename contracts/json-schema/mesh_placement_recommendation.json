{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MeshPlacementRecommendation",
  "type": "object",
  "required": [
    "recommendation_id",
    "tenant_id",
    "generated_utc",
    "nodes",
    "score"
  ],
  "properties": {
    "recommendation_id": { "type": "string" },
    "tenant_id": { "type": "string" },
    "generated_utc": { "type": "string", "format": "date-time" },
    "scenario_id": { "type": "string" },
    "survival_mode_bias": { "type": "boolean" },
    "score": { "type": "number" },
    "constraints": {
      "type": "object",
      "properties": {
        "max_latency_ms": { "type": "number" },
        "min_rssi": { "type": "number" },
        "min_snr": { "type": "number" }
      },
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node_id", "recommended_location", "confidence"],
        "properties": {
          "node_id": { "type": "string" },
          "recommended_location": {
            "type": "object",
            "required": ["lat", "lon"],
            "properties": {
              "lat": { "type": "number" },
              "lon": { "type": "number" },
              "altitude_m": { "type": "number" }
            },
            "additionalProperties": false
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "rationale": { "type": "string" },
          "node_constraints": {
            "type": "object",
            "properties": {
              "max_latency_ms": { "type": "number" },
              "min_rssi": { "type": "number" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "governance": {
      "type": "object",
      "required": ["status", "policy_version", "evaluated_utc"],
      "properties": {
        "status": { "type": "string" },
        "policy_version": { "type": "string" },
        "decision_id": { "type": "string" },
        "evaluated_utc": { "type": "string", "format": "date-time" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "metrics_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "node_count": { "type": "integer" },
        "source": { "type": "string" }
      },
      "additionalProperties": false
    },
    "rationale": { "type": "string" },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false
}
