{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InferenceDiscrepancyEvent",
  "type": "object",
  "required": [
    "discrepancy_id",
    "tenant_id",
    "created_utc",
    "discrepancy_type",
    "severity",
    "sources"
  ],
  "properties": {
    "discrepancy_id": { "type": "string" },
    "tenant_id": { "type": "string" },
    "created_utc": { "type": "string", "format": "date-time" },
    "discrepancy_type": { "type": "string" },
    "severity": { "type": "string" },
    "status": { "type": "string" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "output_hash"],
        "properties": {
          "source_id": { "type": "string" },
          "model_id": { "type": "string" },
          "output_hash": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "additionalProperties": false
      }
    },
    "discrepancies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "observed", "expected"],
        "properties": {
          "field": { "type": "string" },
          "observed": { "type": "string" },
          "expected": { "type": "string" },
          "variance": { "type": "number" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "additionalProperties": false
      }
    },
    "resolution": {
      "type": "object",
      "properties": {
        "resolution_type": { "type": "string" },
        "resolved_utc": { "type": "string", "format": "date-time" },
        "resolved_by": { "type": "string" }
      },
      "additionalProperties": false
    },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false
}
