{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Guardrail constraint configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "validators"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "validators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "settings": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
