{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProcedureDocument",
  "type": "object",
  "required": [
    "document_id",
    "tenant_id",
    "generated_utc",
    "status",
    "title",
    "content"
  ],
  "properties": {
    "document_id": { "type": "string" },
    "tenant_id": { "type": "string" },
    "generated_utc": { "type": "string", "format": "date-time" },
    "status": { "type": "string" },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "content": { "type": "string" },
    "compliance_tags": { "type": "array", "items": { "type": "string" } },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "source_type"],
        "properties": {
          "source_id": { "type": "string" },
          "source_type": { "type": "string" },
          "version": { "type": "string" },
          "checksum": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["approval_id", "status"],
        "properties": {
          "approval_id": { "type": "string" },
          "status": { "type": "string" },
          "decided_utc": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false
}
