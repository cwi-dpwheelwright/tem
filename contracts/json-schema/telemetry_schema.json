{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TelemetryIngestRequest",
  "type": "object",
  "required": [
    "tenant_id",
    "window",
    "signals",
    "metadata"
  ],
  "properties": {
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "window": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tag",
          "unit",
          "series"
        ],
        "properties": {
          "tag": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string"
          },
          "series": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
