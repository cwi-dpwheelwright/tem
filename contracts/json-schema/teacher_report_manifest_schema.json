{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TeacherReportManifest",
  "type": "object",
  "required": ["schema_version", "generated_utc", "artifacts"],
  "properties": {
    "schema_version": { "type": "string" },
    "generated_utc": { "type": "string" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "sha256"],
        "properties": {
          "name": { "type": "string" },
          "sha256": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
