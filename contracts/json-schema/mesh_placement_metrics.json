{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MeshPlacementMetrics",
  "type": "object",
  "required": [
    "metrics_id",
    "node_id",
    "observed_utc",
    "radio",
    "environment",
    "uncertainty"
  ],
  "properties": {
    "metrics_id": { "type": "string" },
    "node_id": { "type": "string" },
    "observed_utc": { "type": "string", "format": "date-time" },
    "scenario_id": { "type": "string" },
    "radio": {
      "type": "object",
      "required": [
        "latency_ms",
        "packet_loss",
        "rssi_dbm",
        "snr_db",
        "throughput_mbps",
        "bandwidth_mbps"
      ],
      "properties": {
        "latency_ms": { "type": "number" },
        "jitter_ms": { "type": "number" },
        "packet_loss": { "type": "number", "minimum": 0, "maximum": 1 },
        "rssi_dbm": { "type": "number" },
        "snr_db": { "type": "number" },
        "throughput_mbps": { "type": "number" },
        "bandwidth_mbps": { "type": "number" },
        "noise_floor_dbm": { "type": "number" },
        "interference_index": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": [
        "temperature_c",
        "humidity_pct"
      ],
      "properties": {
        "temperature_c": { "type": "number" },
        "humidity_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "wind_speed_mps": { "type": "number" },
        "precipitation_mm": { "type": "number" },
        "terrain": { "type": "string" },
        "obstruction_index": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "uncertainty": {
      "type": "object",
      "required": [
        "confidence"
      ],
      "properties": {
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "rssi_stddev": { "type": "number" },
        "snr_stddev": { "type": "number" },
        "latency_stddev": { "type": "number" },
        "throughput_stddev": { "type": "number" },
        "location_stddev_m": { "type": "number" }
      },
      "additionalProperties": false
    },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false
}
