{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DualFormatReport",
  "type": "object",
  "required": [
    "report_id",
    "tenant_id",
    "generated_utc",
    "narrative",
    "structured"
  ],
  "properties": {
    "report_id": { "type": "string" },
    "tenant_id": { "type": "string" },
    "generated_utc": { "type": "string", "format": "date-time" },
    "title": { "type": "string" },
    "status": { "type": "string" },
    "summary": { "type": "string" },
    "coherence_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "conflict_count": { "type": "integer", "minimum": 0 },
    "narrative": { "type": "string" },
    "structured": { "type": "object", "additionalProperties": true },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "source_type"],
        "properties": {
          "source_id": { "type": "string" },
          "source_type": { "type": "string" },
          "version": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false
}
