{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cwi.dev/schemas/ocr_config.json",
  "title": "ETLOcrConfig",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider"],
  "properties": {
    "provider": {
      "type": "string",
      "enum": ["simulated", "disabled"]
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "timeout_seconds": {
      "type": "number",
      "minimum": 0.1,
      "default": 5
    },
    "max_concurrency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32,
      "default": 4
    },
    "max_bytes": {
      "type": "integer",
      "minimum": 1,
      "default": 5000000
    },
    "max_pages": {
      "type": "integer",
      "minimum": 1,
      "default": 25
    },
    "simulated_text": {
      "type": "string"
    }
  }
}
