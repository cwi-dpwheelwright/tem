{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Coordination": {
    "ProtocolVersion": "1.0",
    "RequireClientCertificate": true,
    "Admin": {
      "RequireToken": false,
      "HeaderName": "X-Admin-Token",
      "Token": ""
    },
    "PlacementOptimization": {
      "MaxMetricsLookback": 200,
      "MinConfidence": 0.6,
      "RequireGovernanceApproval": false,
      "PolicyVersion": "1.0",
      "ModelVersion": "heuristic-v1"
    },
    "LinkMetrics": {
      "SnrNormalizationDb": 30,
      "RssiMinDbm": -100,
      "RssiMaxDbm": -30,
      "BandwidthNormalizationKbps": 10000,
      "DefaultSignalQuality": 0.5
    },
    "LinkStateThresholds": {
      "DownSignalQuality": 0.05,
      "DownPacketLoss": 0.8,
      "DownBandwidthKbps": 0,
      "DegradedSignalQuality": 0.3,
      "DegradedPacketLoss": 0.3,
      "DegradedLatencyMs": 1200
    },
    "TopologyHealth": {
      "DownLinkRatioThreshold": 1.0,
      "DegradedLinkRatioThreshold": 0.01,
      "OverallDownNodeRatioThreshold": 0.01,
      "OverallDegradedNodeRatioThreshold": 0.01
    },
    "MeshEvents": {
      "DefaultLimit": 50,
      "MaxLimit": 200,
      "RetentionDays": 30
    },
    "NodeSessions": {
      "KeepaliveIntervalSeconds": 20,
      "HeartbeatIntervalSeconds": 45,
      "TelemetryIntervalSeconds": 120,
      "NodeReadyStaleAfterSeconds": 90,
      "DispatchAckTimeoutSeconds": 5,
      "DispatchExecutionTimeoutSeconds": 180,
      "MaxPendingDispatchPerSession": 25
    }
  },
  "RoutingHints": {
    "DefaultTtlSeconds": 60,
    "CooldownSeconds": 30,
    "HysteresisMargin": 0.1,
    "LatencyNormalizationMs": 1500,
    "JitterNormalizationMs": 200,
    "BandwidthNormalizationKbps": 10000,
    "ThroughputNormalizationKbps": 10000,
    "LowComplexity": {
      "SignalWeight": 0.5,
      "LossWeight": 0.3,
      "LatencyWeight": 0.1,
      "BandwidthWeight": 0.1,
      "JitterWeight": 0.05,
      "ThroughputWeight": 0.05
    },
    "MediumComplexity": {
      "SignalWeight": 0.4,
      "LossWeight": 0.3,
      "LatencyWeight": 0.15,
      "BandwidthWeight": 0.15,
      "JitterWeight": 0.05,
      "ThroughputWeight": 0.1
    },
    "HighComplexity": {
      "SignalWeight": 0.2,
      "LossWeight": 0.2,
      "LatencyWeight": 0.3,
      "BandwidthWeight": 0.2,
      "JitterWeight": 0.1,
      "ThroughputWeight": 0.2
    },
    "InterfaceWeights": {
      "wifi": 1.0,
      "ethernet": 1.0,
      "cellular": 0.9,
      "satellite": 0.7,
      "lora": 0.6
    }
  },
  "Transport": {
    "RequireClientCertificate": true,
    "TrustBundlePath": "/etc/cwi/pki/trust-bundle.pem"
  },
  "Dependencies": {
    "Urls": []
  }
}
