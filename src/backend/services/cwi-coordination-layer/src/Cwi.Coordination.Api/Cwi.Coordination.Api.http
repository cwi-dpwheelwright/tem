@Cwi.Coordination.Api_HostAddress = http://localhost:5242

GET {{Cwi.Coordination.Api_HostAddress}}/health
Accept: application/json

###

GET {{Cwi.Coordination.Api_HostAddress}}/api/ready
Accept: application/json

###

GET {{Cwi.Coordination.Api_HostAddress}}/api/activation/status?node_id=node-1
Accept: application/json

###

POST {{Cwi.Coordination.Api_HostAddress}}/api/degradation/events
Accept: application/json
Content-Type: application/json

{
  "event_id": "event-1",
  "node_id": "node-1",
  "observed_utc": "2026-02-01T00:00:00Z",
  "severity": 0.5,
  "details": {
    "load_1": 1.2
  }
}

###

POST {{Cwi.Coordination.Api_HostAddress}}/api/membership/enroll
Accept: application/json
Content-Type: application/json
X-Coordination-Protocol: 1.0

{
  "node_id": "node-1",
  "cert_fingerprint": "abc123",
  "protocol_version": "1.0"
}

###

POST {{Cwi.Coordination.Api_HostAddress}}/api/rounds
Accept: application/json
Content-Type: application/json
X-Coordination-Protocol: 1.0

{
  "name": "round-1"
}

###

POST {{Cwi.Coordination.Api_HostAddress}}/api/transport/link-metrics
Accept: application/json
Content-Type: application/json

{
  "node_id": "node-1",
  "observed_utc": "2026-02-01T00:00:00Z",
  "interfaces": [
    {
      "interface_id": "wifi0",
      "interface_type": "wifi",
      "observed_utc": "2026-02-01T00:00:00Z",
      "state": "up",
      "rx_mbps": 12.5,
      "tx_mbps": 3.2,
      "mtu": 1500,
      "quality": {
        "latency_ms": 30,
        "jitter_ms": 5,
        "loss_ratio": 0.01,
        "throughput_mbps": 12.0,
        "rssi_dbm": -55,
        "snr_db": 30
      }
    }
  ]
}
