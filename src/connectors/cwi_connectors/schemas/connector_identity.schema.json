{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConnectorIdentityBinding",
  "type": "object",
  "additionalProperties": false,
  "required": ["owner_id"],
  "properties": {
    "owner_id": {
      "type": "string",
      "minLength": 1
    },
    "delegate_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    }
  }
}
