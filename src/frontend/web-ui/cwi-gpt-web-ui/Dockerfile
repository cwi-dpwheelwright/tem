FROM node:20-alpine AS deps
WORKDIR /app
COPY src/frontend/web-ui/cwi-gpt-web-ui/package.json src/frontend/web-ui/cwi-gpt-web-ui/package-lock.json ./
RUN npm ci

FROM node:20-alpine AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
ARG NEXT_PUBLIC_CWI_GATEWAY_BASE_URL
ARG NEXT_PUBLIC_CWI_DEFAULT_TENANT
ARG NEXT_PUBLIC_CWI_AUTH_MODE
ARG NEXT_PUBLIC_CWI_OIDC_AUTHORITY
ARG NEXT_PUBLIC_CWI_OIDC_CLIENT_ID
ARG NEXT_PUBLIC_CWI_OIDC_REDIRECT_URI
ARG NEXT_PUBLIC_CWI_OIDC_POST_LOGOUT_REDIRECT_URI
ARG NEXT_PUBLIC_CWI_OIDC_SCOPES
ARG NEXT_PUBLIC_CWI_POLICY_MODE
ARG NEXT_PUBLIC_CWI_ERROR_REPORT_URL
ARG NEXT_PUBLIC_CWI_REQUEST_TIMEOUT_MS
ARG NEXT_PUBLIC_CWI_BUILD_VERSION
ARG NEXT_PUBLIC_CWI_BUILD_SHA
ARG NEXT_PUBLIC_CWI_GLOBAL_INPUT_FOCUS_ENABLED
ARG NEXT_PUBLIC_CWI_STICKY_CHAT_LAYOUT_ENABLED
ENV NEXT_PUBLIC_CWI_GATEWAY_BASE_URL=${NEXT_PUBLIC_CWI_GATEWAY_BASE_URL}
ENV NEXT_PUBLIC_CWI_DEFAULT_TENANT=${NEXT_PUBLIC_CWI_DEFAULT_TENANT}
ENV NEXT_PUBLIC_CWI_AUTH_MODE=${NEXT_PUBLIC_CWI_AUTH_MODE}
ENV NEXT_PUBLIC_CWI_OIDC_AUTHORITY=${NEXT_PUBLIC_CWI_OIDC_AUTHORITY}
ENV NEXT_PUBLIC_CWI_OIDC_CLIENT_ID=${NEXT_PUBLIC_CWI_OIDC_CLIENT_ID}
ENV NEXT_PUBLIC_CWI_OIDC_REDIRECT_URI=${NEXT_PUBLIC_CWI_OIDC_REDIRECT_URI}
ENV NEXT_PUBLIC_CWI_OIDC_POST_LOGOUT_REDIRECT_URI=${NEXT_PUBLIC_CWI_OIDC_POST_LOGOUT_REDIRECT_URI}
ENV NEXT_PUBLIC_CWI_OIDC_SCOPES=${NEXT_PUBLIC_CWI_OIDC_SCOPES}
ENV NEXT_PUBLIC_CWI_POLICY_MODE=${NEXT_PUBLIC_CWI_POLICY_MODE}
ENV NEXT_PUBLIC_CWI_ERROR_REPORT_URL=${NEXT_PUBLIC_CWI_ERROR_REPORT_URL}
ENV NEXT_PUBLIC_CWI_REQUEST_TIMEOUT_MS=${NEXT_PUBLIC_CWI_REQUEST_TIMEOUT_MS}
ENV NEXT_PUBLIC_CWI_BUILD_VERSION=${NEXT_PUBLIC_CWI_BUILD_VERSION}
ENV NEXT_PUBLIC_CWI_BUILD_SHA=${NEXT_PUBLIC_CWI_BUILD_SHA}
ENV NEXT_PUBLIC_CWI_GLOBAL_INPUT_FOCUS_ENABLED=${NEXT_PUBLIC_CWI_GLOBAL_INPUT_FOCUS_ENABLED}
ENV NEXT_PUBLIC_CWI_STICKY_CHAT_LAYOUT_ENABLED=${NEXT_PUBLIC_CWI_STICKY_CHAT_LAYOUT_ENABLED}
COPY src/frontend/web-ui/cwi-gpt-web-ui/package.json src/frontend/web-ui/cwi-gpt-web-ui/package-lock.json ./
COPY src/frontend/web-ui/cwi-gpt-web-ui/next.config.ts \
  src/frontend/web-ui/cwi-gpt-web-ui/tsconfig.json \
  src/frontend/web-ui/cwi-gpt-web-ui/postcss.config.mjs \
  src/frontend/web-ui/cwi-gpt-web-ui/eslint.config.mjs \
  src/frontend/web-ui/cwi-gpt-web-ui/next-env.d.ts \
  ./
COPY src/frontend/web-ui/cwi-gpt-web-ui/src ./src
COPY src/frontend/web-ui/cwi-gpt-web-ui/public ./public
COPY contracts /contracts
COPY --from=deps /app/node_modules ./node_modules
RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app
ARG NEXT_PUBLIC_CWI_GATEWAY_BASE_URL
ARG NEXT_PUBLIC_CWI_DEFAULT_TENANT
ARG NEXT_PUBLIC_CWI_AUTH_MODE
ARG NEXT_PUBLIC_CWI_OIDC_AUTHORITY
ARG NEXT_PUBLIC_CWI_OIDC_CLIENT_ID
ARG NEXT_PUBLIC_CWI_OIDC_REDIRECT_URI
ARG NEXT_PUBLIC_CWI_OIDC_POST_LOGOUT_REDIRECT_URI
ARG NEXT_PUBLIC_CWI_OIDC_SCOPES
ARG NEXT_PUBLIC_CWI_POLICY_MODE
ARG NEXT_PUBLIC_CWI_ERROR_REPORT_URL
ARG NEXT_PUBLIC_CWI_REQUEST_TIMEOUT_MS
ARG NEXT_PUBLIC_CWI_BUILD_VERSION
ARG NEXT_PUBLIC_CWI_BUILD_SHA
ARG NEXT_PUBLIC_CWI_GLOBAL_INPUT_FOCUS_ENABLED
ARG NEXT_PUBLIC_CWI_STICKY_CHAT_LAYOUT_ENABLED
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PUBLIC_CWI_GATEWAY_BASE_URL=${NEXT_PUBLIC_CWI_GATEWAY_BASE_URL}
ENV NEXT_PUBLIC_CWI_DEFAULT_TENANT=${NEXT_PUBLIC_CWI_DEFAULT_TENANT}
ENV NEXT_PUBLIC_CWI_AUTH_MODE=${NEXT_PUBLIC_CWI_AUTH_MODE}
ENV NEXT_PUBLIC_CWI_OIDC_AUTHORITY=${NEXT_PUBLIC_CWI_OIDC_AUTHORITY}
ENV NEXT_PUBLIC_CWI_OIDC_CLIENT_ID=${NEXT_PUBLIC_CWI_OIDC_CLIENT_ID}
ENV NEXT_PUBLIC_CWI_OIDC_REDIRECT_URI=${NEXT_PUBLIC_CWI_OIDC_REDIRECT_URI}
ENV NEXT_PUBLIC_CWI_OIDC_POST_LOGOUT_REDIRECT_URI=${NEXT_PUBLIC_CWI_OIDC_POST_LOGOUT_REDIRECT_URI}
ENV NEXT_PUBLIC_CWI_OIDC_SCOPES=${NEXT_PUBLIC_CWI_OIDC_SCOPES}
ENV NEXT_PUBLIC_CWI_POLICY_MODE=${NEXT_PUBLIC_CWI_POLICY_MODE}
ENV NEXT_PUBLIC_CWI_ERROR_REPORT_URL=${NEXT_PUBLIC_CWI_ERROR_REPORT_URL}
ENV NEXT_PUBLIC_CWI_REQUEST_TIMEOUT_MS=${NEXT_PUBLIC_CWI_REQUEST_TIMEOUT_MS}
ENV NEXT_PUBLIC_CWI_BUILD_VERSION=${NEXT_PUBLIC_CWI_BUILD_VERSION}
ENV NEXT_PUBLIC_CWI_BUILD_SHA=${NEXT_PUBLIC_CWI_BUILD_SHA}
ENV NEXT_PUBLIC_CWI_GLOBAL_INPUT_FOCUS_ENABLED=${NEXT_PUBLIC_CWI_GLOBAL_INPUT_FOCUS_ENABLED}
ENV NEXT_PUBLIC_CWI_STICKY_CHAT_LAYOUT_ENABLED=${NEXT_PUBLIC_CWI_STICKY_CHAT_LAYOUT_ENABLED}
RUN addgroup -S app && adduser -S app -G app
COPY --from=builder --chown=app:app /app/public ./public
COPY --from=builder --chown=app:app /app/.next/standalone ./
COPY --from=builder --chown=app:app /app/.next/static ./.next/static
USER app
EXPOSE 3000
CMD ["node", "server.js"]
