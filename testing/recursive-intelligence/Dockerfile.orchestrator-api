FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src
COPY . .
RUN dotnet restore src/backend/services/cwi-orchestrator/src/Cwi.Orchestrator.Api/Cwi.Orchestrator.Api.csproj --force-evaluate
RUN dotnet publish src/backend/services/cwi-orchestrator/src/Cwi.Orchestrator.Api/Cwi.Orchestrator.Api.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*
RUN getent group app >/dev/null || addgroup --system app && \
    id -u app >/dev/null 2>&1 || adduser --system --ingroup app app
COPY --from=build --chown=app:app /app/publish .
ENV ASPNETCORE_URLS=http://0.0.0.0:8081
USER app
ENTRYPOINT ["dotnet", "Cwi.Orchestrator.Api.dll"]
